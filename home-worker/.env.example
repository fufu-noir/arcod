# Main server
SERVER_URL=https://api.arcod.xyz
WORKER_API_KEY=change-me-to-a-random-secret

# Worker identity
WORKER_ID=home-worker-1

# SSH tunnel to VPS (for hiding IP from Qobuz API)
SSH_USER=root
SSH_HOST=your-vps-ip
SSH_PORT=22
SSH_PASSWORD=your-vps-password
SOCKS_PORT=41080

# Qobuz credentials (same as server .env)
QOBUZ_APP_ID=
QOBUZ_SECRET=
QOBUZ_AUTH_TOKENS=[]

# R2 (same as server .env)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arcod-downloads
R2_PUBLIC_URL=https://dl.arcod.xyz

# Tuning
POLL_INTERVAL_MS=3000
CLAIM_COUNT=4
TRACK_CONCURRENCY=4
