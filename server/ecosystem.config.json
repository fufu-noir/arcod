{
    "apps": [
        {
            "name": "arcod-server",
            "script": "dist/index.js",
            "cwd": "/opt/arcod-server",
            "instances": 1,
            "exec_mode": "fork",
            "env": {
                "NODE_ENV": "production",
                "PORT": "3000"
            },
            "max_memory_restart": "512M",
            "log_date_format": "YYYY-MM-DD HH:mm:ss",
            "error_file": "/var/log/arcod/error.log",
            "out_file": "/var/log/arcod/out.log",
            "merge_logs": true,
            "restart_delay": 3000,
            "max_restarts": 10,
            "min_uptime": "10s"
        }
    ]
}